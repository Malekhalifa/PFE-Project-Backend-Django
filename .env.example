# Brevo SMTP (Email notifications)
BREVO_SMTP_LOGIN=your_brevo_smtp_login_here
BREVO_SMTP_KEY=your_brevo_smtp_key_here
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USE_TLS=True
BREVO_SMTP_USE_SSL=False

# Sender identity (must be verified in Brevo)
EMAIL_FROM_NAME=QualityLab
EMAIL_FROM_ADDRESS=noreply@qualitylab.com

# Brevo API key (SMS API)
BREVO_API_KEY=your_brevo_api_key_here

# Admin alert recipients
ADMIN_EMAIL=admin@qualitylab.com
ADMIN_PHONE=+21600000000
